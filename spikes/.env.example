# Copier en .env (jamais versionné) et remplir. Ne jamais coller ces valeurs dans un chat.

# --- Démarche Numérique ---------------------------------------------------
DN_API_URL=https://demarche.numerique.gouv.fr/api/v2/graphql
# Jeton DÉDIÉ aux tests, limité à la démarche de test si possible
DN_TOKEN=
# Numéro de la démarche de test
DN_DEMARCHE=
# (optionnel) une démarche que le jeton NE doit PAS pouvoir lire
DN_DEMARCHE_HORS_PERIMETRE=
# Dossiers de test (numéros, séparés par des virgules) — seuls ceux-ci sont modifiés
DN_TEST_DOSSIERS=
# Identifiants de labels de test (donnés par dn_01_catalogue.py), séparés par des virgules
DN_TEST_LABEL_IDS=
# (optionnel) rafale de dn_05_debit.py
DN_RAFALE_REQUETES=60
DN_RAFALE_CONCURRENCE=5

# --- Grist ------------------------------------------------------------------
GRIST_BASE_URL=https://grist.numerique.gouv.fr/api
GRIST_API_KEY=
# Document de TEST, déjà synchronisé par OTP
GRIST_DOC_ID=
# (optionnel) nombre de lignes pour grist_02_upsert.py
GRIST_UPSERT_LIGNES=2000
